# MarketLens Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Monad Testnet RPC URL
MONAD_TESTNET_RPC_URL=

# Monad Testnet deployer private key (for BatchReceiptRegistry deployment)
# Use a development-only key with minimal testnet MON.
# NEVER hardcode this in scripts or README.
MONAD_TESTNET_PRIVATE_KEY=

# BatchReceiptRegistry address (set after deployment)
BATCH_RECEIPT_REGISTRY_ADDRESS=
