# Network profile: local-monad-fork | monad-mainnet
NETWORK_PROFILE=local-monad-fork

# Moss v1 requires an RPC reporting Monad mainnet chain ID 143.
RPC_URL=http://127.0.0.1:8545
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
CHAIN_ID=143

# Reproducibility boundary: Anvil must fork this exact block and startup must
# verify its header hash before deployment or sample generation.
FORK_BLOCK_NUMBER=90057009
FORK_BLOCK_HASH=0xf05d45f8e5bf9d4b68016423d9631b341160bc06b92e6e62ac7402f99be77fe7

# Filled from config/deployments/local-monad-fork.json after running the demo.
PREDICTION_MARKET_ADDRESS=
DEPLOYMENT_BLOCK=

# Indexing range is explicit and inclusive.
INDEX_FROM_BLOCK=
INDEX_TO_BLOCK=
INDEX_CHUNK_SIZE=1000

# Generated local files.
SQLITE_PATH=analytics/data/marketlens.sqlite
EVIDENCE_OUTPUT_PATH=web/public/data

# Moss source must be pinned because npm 0.1.0 and current main differ.
MOSS_REPOSITORY=https://github.com/nishuzumi/moss.git
MOSS_COMMIT=d09b38cbc44ee7f5722c5d09e7224f7750187762
MOSS_RPC_URL=http://127.0.0.1:8545

# Optional only when verifying a deployed ABI through Monadscan.
MONADSCAN_API_KEY=

# Never store a production private key here.
# Local scripts use Anvil's public development keys only.
